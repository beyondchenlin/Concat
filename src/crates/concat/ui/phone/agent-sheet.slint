import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph } from "../icons.slint";
import { IconButton } from "../primitives/panel.slint";
import { AgentChat, AgentScript, AgentUi } from "../agent.slint";
import { AgentSettingsUi } from "../dialogs/model-settings.slint";
import { ScriptUi } from "../script.slint";
import { Focus } from "../util.slint";

/// The phone's one extra entry. Start within the native monitor on the left;
/// afterwards the user owns its position anywhere inside the safe viewport.
export component PhoneAgentLauncher inherits Rectangle {
    in property <length> viewport-width;
    in property <length> viewport-height;
    in property <length> default-y;

    callback clicked();

    private property <bool> positioned;
    private property <length> position-x;
    private property <length> position-y;
    private property <length> origin-x;
    private property <length> origin-y;
    private property <length> pointer-origin-x;
    private property <length> pointer-origin-y;
    private property <bool> dragging;
    private property <bool> was-dragged;
    private property <bool> ring;

    // Keep the requested location while a keyboard or rotation temporarily
    // reduces the viewport. The button can never leave the reachable area.
    x: Math.clamp(root.positioned ? root.position-x : 12px,
        0px, Math.max(0px, root.viewport-width - root.width));
    y: Math.clamp(root.positioned ? root.position-y : root.default-y,
        0px, Math.max(0px, root.viewport-height - root.height));
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background: touch.pressed ? Theme.field-active : Theme.panel;
    border-width: 1px;
    border-color: root.ring ? Theme.accent : Theme.line-strong;

    accessible-role: button;
    accessible-label: I18n.t("agent.phoneOpen");
    accessible-description: I18n.t("agent.phoneMove");
    accessible-action-default => { root.clicked(); }

    function finish-drag(cancelled: bool) {
        if root.dragging && root.was-dragged {
            root.position-x = root.x;
            root.position-y = root.y;
        }
        root.dragging = false;
        if cancelled { root.was-dragged = true; }
    }

    changed viewport-width => { root.finish-drag(true); }
    changed viewport-height => { root.finish-drag(true); }
    changed visible => { if !root.visible { root.finish-drag(true); } }

    // Focus precedes the touch target so keyboard access cannot swallow the
    // pointer press. Moving changes only x/y, never the editor's layout.
    focus := FocusScope {
        focus-gained(reason) => { root.ring = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.ring = false; }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: "AI";
        color: touch.has-hover ? Theme.accent-hover : Theme.accent;
        font-family: Theme.font;
        font-size: 22px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ScaleRotateGestureHandler {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        enabled: root.visible;
        started => { root.finish-drag(true); }
    }
    touch := TouchArea {
        mouse-cursor: move;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.origin-x = root.x;
                root.origin-y = root.y;
                root.pointer-origin-x = self.absolute-position.x + self.mouse-x;
                root.pointer-origin-y = self.absolute-position.y + self.mouse-y;
                root.dragging = true;
                root.was-dragged = false;
            } else if event.kind == PointerEventKind.up {
                root.finish-drag(false);
            } else if event.kind == PointerEventKind.cancel {
                root.finish-drag(true);
            }
        }
        moved => {
            if root.dragging {
                let dx = self.absolute-position.x + self.mouse-x - root.pointer-origin-x;
                let dy = self.absolute-position.y + self.mouse-y - root.pointer-origin-y;
                if Math.abs(dx) > 6px || Math.abs(dy) > 6px { root.was-dragged = true; }
                if root.was-dragged {
                    root.position-x = root.origin-x + dx;
                    root.position-y = root.origin-y + dy;
                    root.positioned = true;
                }
            }
        }
        clicked => {
            if !root.was-dragged {
                focus.focus();
                root.clicked();
            }
        }
    }
    if AgentUi.tool-pending: Rectangle {
        x: parent.width - 12px;
        y: 2px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.accent;
    }
}

/// A presentation layer over a permanently mounted PhoneEditor. Its
/// content uses the existing native chat/approval callbacks; this component
/// never creates a session or turns a dismissal into a permission decision.
export component PhoneAgentSheet inherits Rectangle {
    in property <length> keyboard-inset;

    private property <int> level: AgentUi.phone-sheet-state;
    private property <length> available-height: Math.max(0px, root.height - root.keyboard-inset);
    private property <length> half-height: Math.min(root.available-height,
        Math.max(340px, root.height * 0.58));
    private property <length> settled-height: root.level == 2
        ? root.available-height : root.half-height;
    private property <length> drag;
    private property <length> origin;
    private property <int> origin-level;
    private property <bool> dragging;
    private property <bool> was-dragged;
    private property <bool> handle-ring;
    private property <bool> script-visible: AgentUi.phone-script;
    changed script-visible => {
        // Native approval can replace a focused script field as well as a
        // header tap can. Restore a live focus owner on either route.
        chat.clear-transient();
        Focus.release();
    }

    changed level => {
        root.drag = 0px;
        root.dragging = false;
        if root.level == 0 {
            chat.clear-transient();
            Focus.release();
        }
    }
    changed available-height => {
        // A keyboard/rotation resize cancels an in-flight presentation
        // gesture. It cannot accidentally dismiss or expand the sheet.
        root.drag = 0px;
        root.dragging = false;
        root.was-dragged = true;
    }

    function toggle-height() {
        AgentUi.phone-sheet-state = root.level == 2 ? 1 : 2;
        Focus.release();
    }

    function collapse() {
        AgentUi.phone-sheet-state = 0;
        Focus.release();
    }

    function finish-drag(cancelled: bool) {
        if root.dragging && !cancelled {
            if root.drag < -64px {
                AgentUi.phone-sheet-state = 2;
            } else if root.origin-level == 2 && root.drag > 64px {
                AgentUi.phone-sheet-state = 1;
            } else if root.origin-level == 1 && root.drag > 80px {
                AgentUi.phone-sheet-state = 0;
            }
        }
        if cancelled { root.was-dragged = true; }
        root.drag = 0px;
        root.dragging = false;
    }

    visible: root.level > 0;
    clip: true;
    background: transparent;

    // TouchArea rejects scale/rotation, so a pinch can otherwise reach the
    // still-mounted timeline. Consume that gesture on this modal layer.
    // A second finger also cancels a header drag without changing its level.
    ScaleRotateGestureHandler {
        x: 0;
        y: 0;
        width: root.width;
        height: root.available-height;
        enabled: root.level > 0;
        started => { root.finish-drag(true); }
    }

    // Dismissal outside the sheet is consumed here, so the same press
    // cannot select or scrub a clip underneath. Keyboard space is excluded.
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.available-height;
        background: #00000026;
        TouchArea {
            scroll-event(event) => { return EventResult.accept; }
            clicked => { root.collapse(); }
        }
    }

    surface := Rectangle {
        x: 0;
        y: Math.clamp(root.available-height - root.settled-height + root.drag,
            0px, root.available-height);
        width: root.width;
        height: Math.max(0px, root.available-height - self.y);
        background: Theme.panel;
        border-top-left-radius: root.level == 2 ? 0px : Theme.r-xl;
        border-top-right-radius: root.level == 2 ? 0px : Theme.r-xl;
        clip: true;

        TouchArea { scroll-event(event) => { return EventResult.accept; } }

        header := Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 64px;
            accessible-role: button;
            accessible-label: root.level == 2 ? I18n.t("agent.phoneHalf") : I18n.t("agent.phoneFull");
            accessible-action-default => { root.toggle-height(); }

            handle-focus := FocusScope {
                focus-gained(reason) => { root.handle-ring = reason == FocusReason.tab-navigation; }
                focus-lost(reason) => { root.handle-ring = false; }
                key-pressed(event) => {
                    if event.text == " " || event.text == "\n" {
                        root.toggle-height();
                        return accept;
                    }
                    return reject;
                }
            }
            grab := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.origin = self.absolute-position.y + self.mouse-y;
                        root.origin-level = root.level;
                        root.drag = 0px;
                        root.dragging = true;
                        root.was-dragged = false;
                    } else if event.kind == PointerEventKind.up {
                        root.finish-drag(false);
                    } else if event.kind == PointerEventKind.cancel {
                        root.finish-drag(true);
                    }
                }
                moved => {
                    if root.dragging {
                        let delta = self.absolute-position.y + self.mouse-y - root.origin;
                        if Math.abs(delta) > 6px { root.was-dragged = true; }
                        root.drag = delta;
                    }
                }
                clicked => { if !root.was-dragged { root.toggle-height(); } }
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 7px;
                width: 36px;
                height: 4px;
                border-radius: 2px;
                background: root.handle-ring ? Theme.accent : Theme.line-strong;
            }
            HorizontalLayout {
                x: 12px;
                y: 16px;
                width: parent.width - 18px;
                height: 44px;
                spacing: 2px;
                Text {
                    text: AgentUi.phone-script ? I18n.t("script.title") : I18n.t("agent.assistant");
                    color: Theme.fg;
                    font-size: Theme.fs-lg;
                    font-weight: Theme.weight-title;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                IconButton {
                    target-size: 44px;
                    width: 44px;
                    min-height: 44px;
                    max-height: 44px;
                    text: AgentUi.phone-script ? I18n.t("agent.chat") : I18n.t("script.title");
                    label: AgentUi.phone-script ? I18n.t("agent.phoneChat") : I18n.t("script.openWorkspace");
                    clicked => {
                        AgentUi.phone-script = !AgentUi.phone-script;
                        if AgentUi.phone-script { ScriptUi.open-requested(); }
                    }
                }
                IconButton {
                    target-size: 44px;
                    width: 44px;
                    min-height: 44px;
                    max-height: 44px;
                    glyph: Glyph.settings;
                    label: I18n.t("agent.modelSettings");
                    enabled: !AgentSettingsUi.busy;
                    clicked => { AgentSettingsUi.open-requested(); }
                }
                IconButton {
                    target-size: 44px;
                    width: 44px;
                    min-height: 44px;
                    max-height: 44px;
                    glyph: Glyph.chevron-down;
                    label: I18n.t("agent.collapseAssistant");
                    clicked => { root.collapse(); }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.line;
            }
        }

        // Chat owns its transcript, activity and composer scrollers. There
        // is deliberately no enclosing PhoneScroll to steal their gestures.
        // Keep it mounted while hidden so cursor and reading position survive.
        chat := AgentChat {
            x: 0;
            y: header.height;
            width: parent.width;
            height: Math.max(0px, parent.height - header.height);
            phone: true;
            visible: !AgentUi.phone-script;
        }
        if AgentUi.phone-script: AgentScript {
            x: 0;
            y: header.height;
            width: parent.width;
            height: Math.max(0px, parent.height - header.height);
            compact-sidebar: true;
        }
    }
}
