import { Theme } from "theme/theme.slint";
import { AgentCallUi } from "agent-call.slint";
import { Glyph, Icon } from "icons.slint";
import { IconButton } from "primitives/panel.slint";
import { Select } from "primitives/select.slint";
import { ScriptUi, ScriptWorkspace } from "script.slint";
import { AgentSettingsUi } from "dialogs/model-settings.slint";
import { Focus } from "util.slint";
import { Button } from "primitives/modal.slint";
import { ResizeBox } from "primitives/resize-box.slint";
import { SectionTabs } from "primitives/section-tabs.slint";
import { Pane, PaneHeader, PaneScroll } from "workspace/pane.slint";
import { SourcePreview } from "workspace/media-pane.slint";

export enum AgentView { chat, editor, script }

/// A projection of a real persistent conversation entry, never a demo reply.
export struct AgentMessageData {
    author: string,
    body: string,
    preview: string,
    collapsible: bool,
    pending: bool,
}

export struct AgentSuggestion {
    identity: string,
    label: string,
    detail: string,
    thumbnail: image,
    kind: string,
}

/// Native admission and task state. None of these fields grants authority.
export struct AgentStatusData {
    title: string,
    detail: string,
    missing: string,
    error: string,
    model: string,
    can-send: bool,
    needs-model-setup: bool,
    can-stop: bool,
    can-review: bool,
    can-continue: bool,
    can-discard: bool,
    can-connect: bool,
    recovery-summary: string,
    busy: bool,
    has-progress: bool,
    progress: float,
}

export global AgentUi {
    in-out property <AgentView> view: AgentView.chat;
    changed view => { self.native-scroll-up-pending = false; }
    /// Phone presentation only: 0 closed, 1 half-height, 2 full-height.
    /// Hiding this sheet never stops the session or changes its authority.
    in-out property <int> phone-sheet-state: 0;
    in-out property <bool> phone-script: false;
    // Presentation only. The confirmed native permission remains tool-mode.
    // This is global so Back works even when a header action focused the
    // window rather than a descendant of the chat's own FocusScope.
    in-out property <bool> phone-confirm-full-access: false;
    changed phone-sheet-state => { self.native-scroll-up-pending = false; }
    public function dismiss-phone-transient() -> bool {
        if self.suggestions-open { self.suggestions-open = false; return true; }
        if self.script-picker { self.script-picker = false; return true; }
        if self.phone-confirm-full-access {
            self.phone-confirm-full-access = false;
            return true;
        }
        return false;
    }
    /// Explicit user intent; the native host owns activation and admission.
    callback phone-open-requested();
    /// Desktop only: hiding the sidebar does not stop or reset a task.
    in-out property <bool> sidebar-open: true;
    changed sidebar-open => {
        if !self.sidebar-open { self.native-scroll-up-pending = false; }
    }
    // Only the assistant rail is resizable; the original editor dock is unchanged.
    // Keep the editor dominant at startup; the user can widen the rail with its gutter.
    in-out property <length> sidebar-width: 420px;
    // One policy for direct gutter drags and later window resizes.
    // Called on input/size events rather than bound into layout constraints.
    public pure function bounded-sidebar-width(requested: length, available: length) -> length {
        return Math.clamp(requested, 320px,
            Math.max(320px, Math.min(840px, Math.min(available * 0.46, available - 600px))));
    }
    in-out property <string> draft;
    in-out property <int> draft-cursor;
    in-out property <bool> script-picker;
    in-out property <int> script-index;
    in-out property <[AgentSuggestion]> suggestions;
    in-out property <[AgentSuggestion]> references;
    in-out property <string> attachment-status;
    in-out property <bool> attachment-pending;
    in-out property <string> suggestion-status;
    in-out property <bool> suggestions-open;
    in-out property <int> suggestion-index;
    in-out property <[string]> models;
    in-out property <int> model-index: -1;
    // Safe initial choice: ordinary questions never imply permission to edit.
    in-out property <int> composer-mode: 0;
    callback draft-edited(text: string, cursor: int);
    callback cursor-moved(cursor: int);
    callback trigger-requested(marker: string);
    callback suggestion-chosen(identity: string);
    callback reference-removed(identity: string);
    callback model-chosen(index: int);
    callback attach-requested();
    callback cancel-attachments();
    in-out property <[AgentMessageData]> messages;
    // A native wheel can start a smooth animation before content-y moves.
    // Consume this input before any position/layout callback can mistake an
    // older inertial movement for a new choice to return to the latest reply.
    // It never grants model or edit authority.
    in-out property <bool> native-scroll-up-pending;
    in-out property <AgentStatusData> status: {
        title: "聊天未就绪",
        detail: "请先完成模型配置和调用授权。",
        missing: "待设置：模型渠道、模型名称、调用凭据；待确认：调用授权。",
        error: "",
        model: "未配置模型",
        can-send: false,
        needs-model-setup: true,
        can-stop: false,
        can-review: false,
        can-continue: false,
        can-discard: false,
        can-connect: false,
        recovery-summary: "",
        busy: false,
        has-progress: false,
        progress: 0,
    };

    callback send-requested(text: string);
    callback edit-requested(text: string);
    callback stop-requested();
    callback review-requested();
    callback continue-requested();
    callback discard-requested();
    callback connect-requested();
    // The native session owns these values; the page cannot set authority.
    in property <int> tool-mode: 0;
    in property <bool> tool-connected: false;
    in property <bool> tool-pending: false;
    in property <string> tool-summary;
    in property <string> tool-request-id;
    callback tool-mode-requested(index: int);
    callback tool-decision-requested(request-id: string, approve: bool);
}

/// Approval gestures are tied to the prompt shown at the start of the
/// interaction. Replacing a prompt while the pointer/key is held cancels it.
component ApprovalDecisionButton inherits Rectangle {
    in property <string> label;
    in property <string> request-id;
    in property <bool> approve;
    in property <bool> phone;
    callback decided(request-id: string, approve: bool);

    private property <string> pointer-request;
    private property <string> keyboard-request;
    private property <bool> keyboard-held;
    private property <bool> ring;
    private property <bool> active: root.request-id != "";

    changed request-id => {
        root.pointer-request = "";
        root.keyboard-request = "";
        // Keep keyboard-held until release: an auto-repeat for an older
        // prompt must not arm a new decision after the ID changes.
    }

    accessible-role: button;
    accessible-enabled: root.active;
    accessible-label: root.label;
    accessible-action-default => {
        if root.active { root.decided(root.request-id, root.approve); }
    }

    min-height: root.phone ? 44px : 28px;
    max-height: root.phone ? 44px : 28px;
    min-width: caption.preferred-width + 24px;
    horizontal-stretch: 0;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: root.ring ? Theme.accent : touch.has-hover ? Theme.line-strong : Theme.line;
    background: touch.pressed ? Theme.field-active : touch.has-hover ? Theme.field-hover : Theme.field;
    opacity: root.active ? 1 : 0.45;

    focus := FocusScope {
        enabled: root.active;
        focus-gained(reason) => { root.ring = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => {
            root.ring = false;
            root.keyboard-request = "";
            root.keyboard-held = false;
        }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                if !root.keyboard-held {
                    root.keyboard-held = true;
                    root.keyboard-request = root.request-id;
                }
                return EventResult.accept;
            }
            return EventResult.reject;
        }
        key-released(event) => {
            if event.text == " " || event.text == "\n" {
                let captured = root.keyboard-request;
                root.keyboard-request = "";
                root.keyboard-held = false;
                if captured != "" && captured == root.request-id {
                    root.decided(captured, root.approve);
                }
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
    caption := Text {
        text: root.label;
        color: Theme.fg;
        font-size: Theme.fs;
        font-weight: Theme.weight-title;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.pointer-request = root.request-id;
                focus.focus();
            } else if event.kind == PointerEventKind.cancel {
                root.pointer-request = "";
            }
        }
        clicked => {
            let captured = root.pointer-request;
            root.pointer-request = "";
            if captured != "" && captured == root.request-id {
                root.decided(captured, root.approve);
            }
        }
    }
}

component AgentApprovalActions inherits HorizontalLayout {
    in property <bool> phone;
    height: root.phone ? 44px : 28px;
    spacing: 6px;
    ApprovalDecisionButton {
        phone: root.phone;
        label: "拒绝"; request-id: AgentUi.tool-request-id; approve: false;
        decided(request-id, approve) => { AgentUi.tool-decision-requested(request-id, approve); }
    }
    ApprovalDecisionButton {
        phone: root.phone;
        label: "批准本次"; request-id: AgentUi.tool-request-id; approve: true;
        decided(request-id, approve) => { AgentUi.tool-decision-requested(request-id, approve); }
    }
}

/// Exactly one of these owns scrolling on each layout: the desktop history
/// viewport or the phone's combined content viewport. Share the existing
/// reading-anchor policy instead of treating a resize as a request to follow.
component AgentTranscript inherits Flickable {
    in property <bool> follow-active: true;
    in-out property <bool> follow-end: true;
    out property <length> end-y: Math.min(0px, self.height - self.content-height);
    private property <length> previous-content-y;
    private property <bool> native-scroll-up-pending: AgentUi.native-scroll-up-pending;

    public function follow-latest() {
        self.follow-end = true;
        self.previous-content-y = self.end-y;
        self.content-y = self.end-y;
    }
    public function hold-reading-position() {
        self.follow-end = false;
        self.previous-content-y = self.content-y;
    }
    function observe-native-scroll() {
        if self.follow-active && AgentUi.native-scroll-up-pending {
            self.follow-end = false;
            self.previous-content-y = self.content-y;
            AgentUi.native-scroll-up-pending = false;
        }
    }
    changed native-scroll-up-pending => { self.observe-native-scroll(); }
    changed end-y => {
        if self.follow-active {
            self.observe-native-scroll();
            if self.follow-end {
                self.previous-content-y = self.end-y;
                self.content-y = self.end-y;
            }
        }
    }
    flicked => {
        if self.follow-active {
            self.observe-native-scroll();
            if self.content-y != self.previous-content-y {
                self.follow-end = self.content-y < self.previous-content-y
                    && self.content-y <= self.end-y;
            }
            self.previous-content-y = self.content-y;
        }
    }
    changed content-y => {
        if self.follow-active {
            self.observe-native-scroll();
            if self.content-y < self.previous-content-y && self.content-y <= self.end-y {
                self.follow-end = true;
            } else if self.content-y > self.previous-content-y && self.content-y > self.end-y {
                self.follow-end = false;
            }
            self.previous-content-y = self.content-y;
        }
    }

    @children
}

/// The same three destinations on a desk and a phone. The full original
/// editor remains reachable; switching never opens a second native session.
export component AgentNavigation inherits Rectangle {
    in property <bool> phone;
    in property <string> project-name;
    callback projects();
    callback save();

    height: root.phone ? 48px : 44px;
    background: Theme.panel;

    HorizontalLayout {
        padding: 6px;
        spacing: 6px;
        if !root.phone: Text {
            text: root.project-name;
            color: Theme.fg;
            font-size: Theme.fs-xl;
            font-weight: Theme.weight-title;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Button {
            label: "对话";
            primary: AgentUi.view == AgentView.chat;
            block: root.phone;
            min-height: root.phone ? 36px : 30px;
            max-height: root.phone ? 36px : 30px;
            clicked => {
                if (SourcePreview.open) { SourcePreview.closed(); }
                AgentUi.view = AgentView.chat;
                Focus.release();
            }
        }
        Button {
            label: "手动编辑";
            primary: AgentUi.view == AgentView.editor;
            block: root.phone;
            min-height: root.phone ? 36px : 30px;
            max-height: root.phone ? 36px : 30px;
            clicked => { AgentUi.view = AgentView.editor; Focus.release(); }
        }
        Button {
            label: "文案";
            primary: AgentUi.view == AgentView.script;
            block: root.phone;
            min-height: root.phone ? 36px : 30px;
            max-height: root.phone ? 36px : 30px;
            clicked => { AgentUi.view = AgentView.script; ScriptUi.open-requested(); Focus.release(); }
        }
        Button {
            label: "项目";
            block: root.phone;
            min-height: root.phone ? 36px : 30px;
            max-height: root.phone ? 36px : 30px;
            clicked => { root.projects(); }
        }
        if root.phone: Button {
            label: "保存";
            block: true;
            min-height: 36px;
            max-height: 36px;
            clicked => { root.save(); }
        }
    }
}

/// A selection never grants Full until the existing confirmation acts.
component AgentPermissionSelect inherits Select {
    in property <bool> confirming;
    callback requested(index: int);
    property <int> native-mode: AgentUi.tool-mode;
    changed native-mode => { self.current = self.native-mode; }
    changed confirming => { self.current = AgentUi.tool-mode; }

    options: ["请求批准", "安全新增", "工程内全权"];
    details: ["每次剪辑写入前询问", "仅自动执行安全新增，其他操作仍需批准", "仅在当前工程内执行，不再逐次询问"];
    current: AgentUi.tool-mode;
    enabled: AgentUi.tool-connected && !AgentUi.tool-pending && !root.confirming;
    flat: true;
    snug: true;
    min-width: 86px;
    max-width: 108px;
    horizontal-stretch: 0;
    popup-above: true;
    stacked-details: true;
    min-popup-width: 246px;
    changed(index) => {
        if index == 2 && AgentUi.tool-mode != 2 { self.current = AgentUi.tool-mode; }
        root.requested(index);
    }
}

export component AgentChat inherits Rectangle {
    in property <bool> phone;
    init => { AgentUi.native-scroll-up-pending = false; }
    background: Theme.panel;
    border-radius: Theme.r-lg;
    private property <bool> send-help;
    // Expansion belongs to the chat surface, not each recycled model row.
    // It survives streamed model updates and avoids reflowing all tool logs.
    private property <int> expanded-message-index: -1;
    // Full access remains unchanged until the person explicitly confirms it.
    private property <bool> desktop-confirm-full-access;
    private property <bool> confirm-full-access: root.phone
        ? AgentUi.phone-confirm-full-access : root.desktop-confirm-full-access;
    private property <bool> helping: root.send-help && AgentUi.draft != "" && !AgentUi.status.busy;
    private property <bool> has-activity: AgentUi.tool-pending
        || AgentUi.status.busy || AgentUi.status.has-progress
        || (AgentUi.status.can-send && AgentUi.status.title == "操作未执行")
        || AgentUi.status.error != "" || AgentUi.status.missing != ""
        || AgentUi.status.recovery-summary != ""
        || (!root.helping && (AgentUi.status.can-review || AgentUi.status.can-continue
            || AgentUi.status.can-connect || AgentUi.status.can-discard
            || AgentCallUi.can-authorize || AgentCallUi.allowed));
    private property <bool> phone-picker-open: root.phone
        && (AgentUi.suggestions-open || AgentUi.script-picker);
    changed phone-picker-open => {
        if root.phone-picker-open { phone-content.follow-latest(); }
    }
    private property <string> phone-pending-id: root.phone && AgentUi.tool-pending
        ? AgentUi.tool-request-id : "";
    changed phone-pending-id => {
        if root.phone-pending-id != "" {
            root.clear-transient();
            phone-content.follow-latest();
        }
    }

    /// Back dismisses a local chooser before changing the phone sheet.
    /// This is presentation state, never an answer to a native approval.
    public function dismiss-transient() -> bool {
        if root.phone { return AgentUi.dismiss-phone-transient(); }
        if AgentUi.suggestions-open { AgentUi.suggestions-open = false; return true; }
        if AgentUi.script-picker { AgentUi.script-picker = false; return true; }
        if root.confirm-full-access {
            root.set-full-confirmation(false);
            return true;
        }
        return false;
    }

    /// Dismiss local choosers/confirmation when the phone surface is hidden.
    /// Drafts, persistent messages and pending native decisions are untouched.
    public function clear-transient() {
        AgentUi.suggestions-open = false;
        AgentUi.script-picker = false;
        root.set-full-confirmation(false);
        root.send-help = false;
    }

    function set-full-confirmation(open: bool) {
        if root.phone { AgentUi.phone-confirm-full-access = open; }
        else { root.desktop-confirm-full-access = open; }
    }

    function choose-permission(index: int) {
        if index == 2 && AgentUi.tool-mode != 2 {
            root.set-full-confirmation(true);
            if root.phone { phone-content.follow-latest(); }
        } else {
            root.set-full-confirmation(false);
            AgentUi.tool-mode-requested(index);
        }
    }

    function send-draft() {
        if AgentUi.attachment-pending || !AgentUi.status.can-send {
            root.send-help = true;
            if root.phone { phone-content.follow-latest(); }
        } else {
            root.send-help = false;
            root.expanded-message-index = -1;
            // Sending explicitly returns to the live conversation. Keep that
            // intent when the busy row or the new message changes the layout.
            AgentUi.native-scroll-up-pending = false;
            if root.phone { phone-content.follow-latest(); }
            else { side-transcript.follow-latest(); }
            if AgentUi.composer-mode == 1 { AgentUi.edit-requested(AgentUi.draft); }
            else { AgentUi.send-requested(AgentUi.draft); }
        }
    }

    function resume-composing() {
        // Synchronize the actual caret after programmatic @ / command edits
        // on phones too, without opening the phone's software keyboard.
        side-prompt.set-selection-offsets(AgentUi.draft-cursor, AgentUi.draft-cursor);
        if !root.phone {
            side-prompt.focus();
        }
    }

    chat-keys := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if root.phone && (event.text == Key.Back || event.text == Key.Escape)
                && root.dismiss-transient() {
                return accept;
            }
            return reject;
        }
    chat-layout := VerticalLayout {
        padding: 10px;
        // Keep a 40px reading target alongside references, approval and
        // the minimum composer in a 320px phone sheet (64px header).
        padding-top: root.phone ? 8px : 10px;
        padding-bottom: root.phone ? 8px : 10px;
        spacing: 6px;
        // On a phone this is the sole scrolling content region. All optional
        // detail gives up viewport space before approvals or the composer.
        // On desktop it is a non-scrolling wrapper around the original layout.
        phone-content := AgentTranscript {
            follow-active: root.phone;
            interactive: root.phone;
            vertical-stretch: 1;
            // Minimum layout size must not read the allocated parent
            // height. A fixed reading target makes the resized composer
            // yield first without feeding layout allocation back into it.
            min-height: root.phone ? 40px : content-column.min-height;
            // Flickable forwards its child's maximum by default. On phones
            // the transcript must fill the space above the fixed composer,
            // even when an empty conversation has only a short content row.
            max-height: root.phone ? 100000px : content-column.max-height;
            accessible-role: list;
            accessible-label: root.phone ? "对话记录" : "";
            content-width: self.width;
            content-height: root.phone
                ? Math.max(self.height, content-column.preferred-height) : self.height;
            content-column := VerticalLayout {
                width: phone-content.width;
                height: root.phone
                    ? Math.max(phone-content.height, self.preferred-height) : phone-content.height;
                spacing: 6px;
        side-transcript := AgentTranscript {
            follow-active: !root.phone;
            interactive: !root.phone;
            vertical-stretch: root.phone ? 0 : 1;
            min-height: root.phone ? side-entries.preferred-height : 40px;
            preferred-height: root.phone ? side-entries.preferred-height : 40px;
            max-height: root.phone ? side-entries.preferred-height : 100000px;
            accessible-role: list;
            accessible-label: root.phone ? "" : "对话记录";
            content-width: self.width;
            content-height: Math.max(self.height, side-entries.preferred-height);
            side-entries := VerticalLayout {
                width: side-transcript.width; height: self.preferred-height; spacing: 8px; alignment: start;
                if AgentUi.messages.length == 0: Text {
                    text: "可以提问当前工程；需要修改时，请选择“剪辑”。"; color: Theme.fg-dim; font-size: Theme.fs; wrap: word-wrap;
                }
                for message[index] in AgentUi.messages: Rectangle {
                    // Only the user's prompt is a bubble. Assistant responses and
                    // tool events use a quiet transcript, like the reference UI.
                    height: message-row.preferred-height;
                    background: message.author == "我" ? Theme.well : transparent;
                    border-radius: Theme.r;
                    message-row := VerticalLayout {
                        padding: 8px; spacing: 4px;
                        Text { text: message.author + (message.pending ? " · 接收中" : ""); color: Theme.fg-dim; font-size: Theme.fs-sm; }
                        if !message.collapsible || root.expanded-message-index == index: Text {
                            text: message.body; color: Theme.fg; font-size: Theme.fs; wrap: word-wrap;
                        }
                        if message.collapsible && root.expanded-message-index != index: Text {
                            text: message.preview; color: Theme.fg; font-size: Theme.fs; wrap: word-wrap;
                        }
                        if message.collapsible: Button {
                            label: root.expanded-message-index == index ? "收起详情" : "展开完整内容";
                            ghost: true; align-left: true;
                            clicked => {
                                // Opening or closing history is an explicit
                                // reading action, not a request to jump ahead.
                                if root.phone { phone-content.hold-reading-position(); }
                                else { side-transcript.hold-reading-position(); }
                                root.expanded-message-index = root.expanded-message-index == index ? -1 : index;
                            }
                        }
                    }
                }
            }
        }
        // The history stays first. Transient details give up space before
        // decisions or the composer; their one scroller owns its wheel events.
        if root.has-activity: Rectangle {
            min-height: activity-layout.min-height;
            preferred-height: activity-layout.preferred-height;
            max-height: activity-layout.preferred-height;
            vertical-stretch: 0;
            border-radius: Theme.r;
            background: AgentUi.tool-pending ? Theme.well : transparent;
            border-width: AgentUi.tool-pending ? 1px : 0px;
            border-color: Theme.accent;
            activity-layout := VerticalLayout {
                padding: AgentUi.tool-pending ? 8px : 0px;
                spacing: 6px;
                activity-details := PaneScroll {
                    scroll-enabled: !root.phone;
                    // A complete native action row must remain scrollable into view.
                    min-height: root.phone ? activity-copy.preferred-height
                        : Math.max(28px, Theme.fs-sm * 1.4);
                    preferred-height: root.phone ? activity-copy.preferred-height
                        : Math.max(self.min-height, Math.min(156px, activity-copy.preferred-height));
                    max-height: self.preferred-height;
                    vertical-stretch: 0;
                    accessible-role: list;
                    accessible-label: AgentUi.tool-pending ? "剪辑操作详情" : "会话状态详情";
                    private property <string> request-identity: AgentUi.tool-request-id;
                    changed request-identity => { self.reset-scroll(); }
                    activity-copy := VerticalLayout {
                        spacing: 6px;
                        if AgentUi.tool-pending: VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "批准当前工程的剪辑操作？";
                                color: Theme.fg; font-size: Theme.fs;
                                font-weight: Theme.weight-title;
                            }
                            Text {
                                text: AgentUi.tool-summary; color: Theme.fg-muted;
                                font-size: Theme.fs-sm; wrap: word-wrap;
                            }
                        }
                        if AgentUi.status.busy || (AgentUi.status.can-send && AgentUi.status.title == "操作未执行"): Text {
                            text: AgentUi.status.title + (AgentUi.status.detail == "" ? "" : " · " + AgentUi.status.detail);
                            color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap;
                        }
                        if AgentUi.status.has-progress: Rectangle {
                            height: 4px; border-radius: 2px; background: Theme.field;
                            Rectangle { width: parent.width * Math.clamp(AgentUi.status.progress, 0, 1); height: parent.height; border-radius: 2px; background: Theme.accent; }
                        }
                        if AgentUi.status.error != "": VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: AgentUi.status.error; color: Theme.danger; font-size: Theme.fs; wrap: word-wrap;
                            }
                            if AgentUi.status.error == "模型服务未接受当前密钥（401）。"
                                || AgentUi.status.error == "模型账户余额或计费额度不足（402）。"
                                || AgentUi.status.error == "模型服务拒绝当前账户或模型访问权限（403）。": HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: AgentUi.status.error == "模型服务未接受当前密钥（401）。"
                                        ? "请核对当前服务密钥及模型配置。"
                                        : AgentUi.status.error == "模型账户余额或计费额度不足（402）。"
                                            ? "请检查模型服务账户的余额和计费额度。"
                                            : "请检查当前账户是否拥有所选模型的访问权限。";
                                    color: Theme.fg-muted; font-size: Theme.fs-sm;
                                    wrap: word-wrap; horizontal-stretch: 1;
                                }
                                Button { label: "检查模型"; clicked => { AgentSettingsUi.open-requested(); } }
                            }
                            if AgentUi.status.error == "当前工程标识尚未保存或已改变，文案操作已停止，请重新打开工程。": HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "保存后重新打开工程，再连接智能会话。";
                                    color: Theme.fg-muted; font-size: Theme.fs-sm;
                                    wrap: word-wrap; horizontal-stretch: 1;
                                }
                                if AgentUi.status.can-stop: Button {
                                    label: "停止会话"; clicked => { AgentUi.stop-requested(); }
                                }
                            }
                        }
                        if AgentUi.status.missing != "": Text {
                            text: AgentUi.status.missing; color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap;
                        }
                        if AgentUi.status.recovery-summary != "": Text {
                            text: AgentUi.status.recovery-summary; color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap;
                        }
                        if !root.helping && (AgentUi.status.can-review || AgentUi.status.can-continue || AgentUi.status.can-connect || AgentUi.status.can-discard): HorizontalLayout {
                            spacing: 4px; alignment: start;
                            if AgentUi.status.can-review: Button { label: "核对工程"; clicked => { AgentUi.review-requested(); } }
                            if AgentUi.status.can-continue: Button { label: "确认继续"; clicked => { AgentUi.continue-requested(); } }
                            if AgentUi.status.can-connect: Button { label: "连接会话"; clicked => { AgentUi.connect-requested(); } }
                            if AgentUi.status.can-discard: Button { label: "放弃任务"; clicked => { AgentUi.discard-requested(); } }
                        }
                        if !root.helping && (AgentCallUi.can-authorize || AgentCallUi.allowed): HorizontalLayout {
                            spacing: 4px;
                            Text { text: AgentCallUi.usage-policy; color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; horizontal-stretch: 1; }
                            Button { label: AgentCallUi.allowed ? "撤回授权" : "允许调用"; enabled: AgentCallUi.can-authorize || AgentCallUi.allowed; clicked => { AgentCallUi.authorize-requested(); } }
                        }
                    }
                }
                // Keep the identity-bound decisions outside the scrolled text.
                if AgentUi.tool-pending && !root.phone: AgentApprovalActions { }
            }
        }
        if AgentUi.suggestions-open: Rectangle {
            min-height: suggestion-list.preferred-height; max-height: suggestion-list.preferred-height;
            background: Theme.well; border-radius: Theme.r; border-width: 1px; border-color: Theme.line;
            suggestion-list := VerticalLayout {
                padding: 4px; spacing: 2px;
                Text { text: AgentUi.suggestion-status; color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; }
                for suggestion[index] in AgentUi.suggestions: Rectangle {
                    height: 38px; border-radius: Theme.r-sm;
                    accessible-role: button; accessible-label: suggestion.label + " " + suggestion.detail;
                    accessible-action-default => { AgentUi.suggestion-chosen(suggestion.identity); root.resume-composing(); }
                    background: index == AgentUi.suggestion-index || suggestion-touch.has-hover ? Theme.field-hover : transparent;
                    HorizontalLayout {
                        padding-left: 5px; padding-right: 5px; spacing: 6px;
                        Rectangle {
                            width: 38px; height: 30px; border-radius: Theme.r-sm; background: Theme.field; clip: true;
                            Icon { x: 12px; y: 8px; glyph: suggestion.kind == "视频" ? Glyph.film : suggestion.kind == "音频" ? Glyph.music : suggestion.kind == "图片" ? Glyph.image : Glyph.text-mark; size: 14px; tint: Theme.fg-muted; }
                            Image { width: parent.width; height: parent.height; source: suggestion.thumbnail; image-fit: cover; }
                        }
                        Text { text: suggestion.label; color: Theme.fg; font-size: Theme.fs; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: suggestion.detail; color: Theme.fg-muted; font-size: Theme.fs-sm; vertical-alignment: center; }
                    }
                    suggestion-touch := TouchArea { mouse-cursor: pointer; clicked => { AgentUi.suggestion-chosen(suggestion.identity); root.resume-composing(); } }
                }
            }
        }
        if AgentUi.script-picker: Rectangle {
            min-height: script-picker-layout.preferred-height; max-height: script-picker-layout.preferred-height;
            background: Theme.well; border-radius: Theme.r; border-width: 1px; border-color: Theme.line;
            script-picker-layout := VerticalLayout {
                padding: 6px; spacing: 4px;
                HorizontalLayout {
                    Text { text: "选择文案版本"; color: Theme.fg; font-size: Theme.fs; horizontal-stretch: 1; vertical-alignment: center; }
                    IconButton { glyph: Glyph.close; label: "关闭文案选择"; clicked => { AgentUi.script-picker = false; root.resume-composing(); } }
                }
                if ScriptUi.busy: Text { text: "正在读取文案…"; color: Theme.fg-muted; font-size: Theme.fs-sm; }
                if ScriptUi.error != "": Text { text: ScriptUi.error; color: Theme.danger; font-size: Theme.fs-sm; wrap: word-wrap; }
                if ScriptUi.ready && ScriptUi.dirty: Text { text: "请先保存或放弃未保存的文案修改。"; color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; }
                if ScriptUi.ready && ScriptUi.versions.length == 0: Text { text: "还没有保存的版本，请在文案页创建。"; color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; }
                if ScriptUi.versions.length > 0: Flickable {
                    interactive: !root.phone;
                    height: root.phone ? script-version-rows.preferred-height
                        : Math.min(180px, script-version-rows.preferred-height);
                    content-width: self.width; content-height: script-version-rows.preferred-height;
                    property <int> active-version: AgentUi.script-index;
                    changed active-version => {
                        if (self.active-version * 30px < -self.content-y) { self.content-y = -self.active-version * 30px; }
                        else if ((self.active-version + 1) * 30px > -self.content-y + self.height) { self.content-y = self.height - (self.active-version + 1) * 30px; }
                    }
                    script-version-rows := VerticalLayout {
                        width: parent.width; height: self.preferred-height; spacing: 2px;
                        for version[index] in ScriptUi.versions: Button {
                            label: (index == AgentUi.script-index ? "› " : "  ") + version.label + (version.selected ? " · 已选择" : ""); ghost: true; block: true; align-left: true;
                            enabled: ScriptUi.ready && !ScriptUi.busy && !ScriptUi.dirty;
                            clicked => { ScriptUi.select-version-requested(version.identity); AgentUi.composer-mode = 1; AgentUi.script-picker = false; root.resume-composing(); }
                        }
                    }
                }
                Button {
                    label: "打开文案页"; ghost: true;
                    clicked => {
                        AgentUi.script-picker = false;
                        if root.phone { AgentUi.phone-script = true; }
                        else { AgentUi.view = AgentView.script; }
                        ScriptUi.open-requested();
                        Focus.release();
                    }
                }
            }
        }
        if AgentUi.attachment-status != "": HorizontalLayout {
            spacing: 4px;
            Text { text: AgentUi.attachment-status; color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; horizontal-stretch: 1; }
            if AgentUi.attachment-pending: Button { label: "取消引用"; ghost: true; clicked => { AgentUi.cancel-attachments(); } }
        }
        if ScriptUi.error != "" && AgentUi.composer-mode == 1 && !AgentUi.script-picker: Text {
            text: ScriptUi.error; color: Theme.danger; font-size: Theme.fs-sm; wrap: word-wrap;
        }
        if root.helping: VerticalLayout {
            vertical-stretch: 0; spacing: 4px;
            HorizontalLayout {
                Text {
                    horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap;
                    font-size: Theme.fs-sm; color: Theme.fg;
                    text: AgentUi.attachment-pending ? "素材正在导入，完成后即可发送。"
                        : AgentUi.status.needs-model-setup ? "发送前请设置模型渠道，并保存该渠道的凭据。"
                        : AgentUi.status.can-connect ? "先连接当前工程的 Pi 会话。"
                        : AgentUi.status.can-continue ? "当前工程已核对，请确认打开会话。"
                        : AgentUi.status.can-review ? AgentUi.status.recovery-summary != "" ? AgentUi.status.recovery-summary : "请先核对当前工程。"
                        : AgentCallUi.can-authorize && !AgentCallUi.allowed ? AgentCallUi.usage-policy
                        : AgentUi.status.error != "" ? AgentUi.status.error
                        : AgentUi.status.can-send ? "可以发送这条消息了。" : AgentUi.status.detail;
                }
                IconButton { glyph: Glyph.close; label: "关闭发送提示"; clicked => { root.send-help = false; } }
            }
            HorizontalLayout {
                alignment: start; spacing: 4px;
                if AgentUi.status.needs-model-setup: Button { label: "配置模型"; clicked => { AgentSettingsUi.open-requested(); } }
                if !AgentUi.status.needs-model-setup && AgentUi.status.can-connect: Button { label: "连接会话"; clicked => { AgentUi.connect-requested(); } }
                if AgentUi.status.can-review && !AgentUi.status.can-continue: Button { label: "核对工程"; clicked => { AgentUi.review-requested(); } }
                if AgentUi.status.can-continue: Button { label: "确认继续"; clicked => { AgentUi.continue-requested(); } }
                if AgentUi.status.can-discard: Button { label: "放弃任务"; clicked => { AgentUi.discard-requested(); } }
                if AgentCallUi.can-authorize && !AgentCallUi.allowed && !AgentUi.attachment-pending: Button {
                    label: "允许并发送"; primary: true;
                    clicked => {
                        AgentCallUi.authorize-requested();
                        if AgentCallUi.allowed { root.send-draft(); }
                    }
                }
                if AgentCallUi.allowed && !AgentUi.status.can-send: Button { label: "撤回授权"; clicked => { AgentCallUi.authorize-requested(); } }
            }
        }
        if root.confirm-full-access: Rectangle {
            min-height: full-warning-layout.preferred-height;
            border-radius: Theme.r;
            background: Theme.well;
            border-width: 1px;
            border-color: Theme.danger;
            full-warning-layout := VerticalLayout {
                padding: 8px; spacing: 6px;
                Text {
                    text: "确认开启完全访问权限？";
                    color: Theme.danger; font-size: Theme.fs;
                    font-weight: Theme.weight-title;
                }
                Text {
                    text: "本会话将自动执行当前工程内通过原生校验的剪辑写操作，包括移动、删除和批量修改，不再逐项询问。仍受当前工程和任务权限限制；不等于访问电脑全部文件或网络。";
                    color: Theme.fg; font-size: Theme.fs-sm; wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 6px;
                    Button {
                        label: "取消"; ghost: true;
                        clicked => { root.set-full-confirmation(false); }
                    }
                    Button {
                        label: "确认开启"; primary: true;
                        enabled: AgentUi.tool-connected && !AgentUi.tool-pending;
                        clicked => {
                            root.set-full-confirmation(false);
                            AgentUi.tool-mode-requested(2);
                        }
                    }
                }
            }
        }
            }
        }
        if root.phone && AgentUi.tool-pending: AgentApprovalActions { phone: true; }
        composer := Rectangle {
            min-height: composer-layout.min-height;
            preferred-height: composer-layout.preferred-height;
            max-height: composer-layout.preferred-height;
            vertical-stretch: 0;
            background: Theme.well; border-radius: Theme.r; border-width: 1px;
            // Keep the compose area quiet even while typing.
            border-color: Theme.line;
            composer-layout := VerticalLayout {
                padding: 5px; spacing: 2px;
                side-prompt-box := ResizeBox {
                    box-height: 66px; min-box: 56px; max-box: 150px; flat: true;
                    allow-layout-shrink: true;
                    accessible-role: groupbox;
                    accessible-label: "对话输入区域";
                    content-height: side-prompt.preferred-height; focused: side-prompt.has-focus;
                    side-prompt := TextInput {
                        x: 0px; y: side-prompt-box.pad-y;
                        width: side-prompt-box.width - 2 * side-prompt-box.pad-x;
                        height: Math.max(self.preferred-height, side-prompt-box.view-height);
                        text <=> AgentUi.draft; single-line: false; wrap: word-wrap;
                        color: Theme.fg; font-size: Theme.fs-input;
                        selection-background-color: Theme.accent; selection-foreground-color: Theme.on-accent;
                        accessible-role: text-input;
                        accessible-label: AgentUi.composer-mode == 1 ? "剪辑要求" : "对话输入";
                        accessible-value <=> self.text;
                        accessible-action-set-value(value) => { self.text = value; AgentUi.draft-edited(self.text, self.cursor-position-byte-offset); }
                        accessible-action-set-selection-offsets(anchor, focus) => { self.set-selection-offsets(anchor, focus); }
                        edited => { AgentUi.draft-edited(self.text, self.cursor-position-byte-offset); }
                        key-pressed(event) => {
                            if AgentUi.script-picker && event.text == Key.Escape { AgentUi.script-picker = false; return accept; }
                            if AgentUi.script-picker && ScriptUi.ready && !ScriptUi.busy && !ScriptUi.dirty && ScriptUi.versions.length > 0 {
                                if event.text == Key.DownArrow { AgentUi.script-index = Math.mod(AgentUi.script-index + 1, ScriptUi.versions.length); return accept; }
                                if event.text == Key.UpArrow { AgentUi.script-index = Math.mod(AgentUi.script-index - 1 + ScriptUi.versions.length, ScriptUi.versions.length); return accept; }
                                if event.text == Key.Return { ScriptUi.select-version-requested(ScriptUi.versions[AgentUi.script-index].identity); AgentUi.composer-mode = 1; AgentUi.script-picker = false; return accept; }
                            }
                            if AgentUi.suggestions-open && event.text == Key.Escape { AgentUi.suggestions-open = false; return accept; }
                            if AgentUi.suggestions-open && AgentUi.suggestions.length > 0 {
                                if event.text == Key.DownArrow { AgentUi.suggestion-index = Math.mod(AgentUi.suggestion-index + 1, AgentUi.suggestions.length); return accept; }
                                if event.text == Key.UpArrow { AgentUi.suggestion-index = Math.mod(AgentUi.suggestion-index - 1 + AgentUi.suggestions.length, AgentUi.suggestions.length); return accept; }
                                if event.text == Key.Return { AgentUi.suggestion-chosen(AgentUi.suggestions[AgentUi.suggestion-index].identity); self.set-selection-offsets(AgentUi.draft-cursor, AgentUi.draft-cursor); return accept; }
                            }
                            return reject;
                        }
                        cursor-position-changed(at) => { AgentUi.cursor-moved(self.cursor-position-byte-offset); side-prompt-box.reveal(at.y, self.font-size * 1.4); }
                    }
                    if AgentUi.draft == "": Text {
                        x: 0px; y: side-prompt-box.pad-y;
                        width: side-prompt-box.width - 2 * side-prompt-box.pad-x;
                        horizontal-alignment: left;
                        text: AgentUi.composer-mode == 1
                            ? "描述剪辑要求；输入 @ 引用素材，/ 使用命令…"
                            : "输入消息；输入 @ 引用素材，/ 使用命令…";
                        color: Theme.fg-dim; font-size: Theme.fs; wrap: word-wrap;
                    }
                }
                if AgentUi.references.length > 0 || (AgentUi.composer-mode == 1 && ScriptUi.selected-label != "尚未选择剪辑版本"): Flickable {
                    height: 30px; content-width: Math.max(self.width, reference-row.preferred-width); content-height: self.height;
                    reference-row := HorizontalLayout {
                        x: 0px; width: self.preferred-width; height: parent.height; spacing: 4px; alignment: start;
                        for reference in AgentUi.references: Button { label: reference.label + " ×"; clicked => { AgentUi.reference-removed(reference.identity); } }
                        if AgentUi.composer-mode == 1 && ScriptUi.selected-label != "尚未选择剪辑版本": Button {
                            label: ScriptUi.selected-label;
                            clicked => { AgentUi.script-picker = true; ScriptUi.open-requested(); }
                        }
                    }
                }
                // Preserve one row above the phone keyboard. Its compact
                // labels leave room for 44px action targets even at 320px.
                HorizontalLayout {
                    height: root.phone ? 44px : 32px; spacing: 2px; alignment: center;
                    IconButton {
                        target-size: root.phone ? 44px : 26px;
                        width: root.phone ? 44px : 26px;
                        glyph: Glyph.plus; label: "导入素材";
                        clicked => { AgentUi.attach-requested(); }
                    }
                    if AgentUi.models.length > 0: Select {
                        options: AgentUi.models; current: AgentUi.model-index; placeholder: "选择模型";
                        enabled: !AgentSettingsUi.busy && !AgentUi.status.busy; flat: true; snug: true;
                        min-width: root.phone ? 56px : 64px; max-width: 88px; horizontal-stretch: 0;
                        height: root.phone ? 44px : Theme.h;
                        stacked-details: root.phone;
                        popup-above: root.phone;
                        changed(index) => { AgentUi.model-chosen(index); }
                    }
                    if AgentUi.models.length == 0: Button {
                        label: root.phone ? "模型" : "配置模型";
                        accessible-label: "配置模型";
                        ghost: true; enabled: !AgentSettingsUi.busy;
                        min-height: root.phone ? 44px : 28px;
                        max-height: root.phone ? 44px : 28px;
                        clicked => { AgentSettingsUi.open-requested(); }
                    }
                    Select {
                        options: ["对话", "剪辑"]; current <=> AgentUi.composer-mode;
                        flat: true; snug: true; min-width: root.phone ? 48px : 58px; max-width: 68px; horizontal-stretch: 0;
                        height: root.phone ? 44px : Theme.h;
                        stacked-details: root.phone;
                        popup-above: root.phone;
                    }
                    AgentPermissionSelect {
                        height: root.phone ? 44px : Theme.h;
                        confirming: root.confirm-full-access;
                        requested(index) => { root.choose-permission(index); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if AgentUi.status.busy && AgentUi.status.can-stop: IconButton {
                        target-size: root.phone ? 44px : 26px;
                        width: root.phone ? 44px : 26px;
                        glyph: Glyph.stop; label: "停止";
                        clicked => { AgentUi.stop-requested(); }
                    }
                    if !AgentUi.status.busy: IconButton {
                        target-size: root.phone ? 44px : 26px;
                        width: root.phone ? 44px : 26px;
                        glyph: Glyph.send; label: "发送"; accent: true;
                        enabled: AgentUi.draft != "";
                        clicked => { root.send-draft(); }
                    }
                }
            }
        }

    }
    }
}

export component AgentScript inherits ScriptWorkspace {}

/// The desktop editor stays mounted while its assistant is opened or hidden.
export component AgentSidebar inherits Rectangle {
    background: Theme.page;
    clip: true;

    VerticalLayout {
        padding: AgentUi.sidebar-open ? 6px : 0px;

        if AgentUi.sidebar-open: Pane {
            PaneHeader {
                title: "Pi 助手";
                IconButton { glyph: Glyph.settings; label: "模型设置"; enabled: !AgentSettingsUi.busy; clicked => { AgentSettingsUi.open-requested(); } }
                IconButton { glyph: Glyph.chevrons-right; label: "收起 Pi 助手"; clicked => { AgentUi.sidebar-open = false; Focus.release(); } }
            }
            SectionTabs {
                height: 40px;
                options: ["对话", "文案"];
                current: AgentUi.view == AgentView.script ? 1 : 0;
                changed(index) => {
                    if index == 1 {
                        AgentUi.view = AgentView.script;
                        ScriptUi.open-requested();
                    } else {
                        AgentUi.view = AgentView.chat;
                    }
                    Focus.release();
                }
            }
            if AgentUi.view != AgentView.script: AgentChat {
                vertical-stretch: 1;
            }
            if AgentUi.view == AgentView.script: AgentScript {
                compact-sidebar: true;
                vertical-stretch: 1;
            }
        }
        if !AgentUi.sidebar-open: Pane {
            IconButton {
                text: "Pi";
                min-height: 32px; max-height: 32px;
                label: "展开 Pi 助手";
                clicked => { AgentUi.sidebar-open = true; Focus.release(); }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
