import { I18n } from "i18n.slint";
import { Theme } from "theme/theme.slint";
import { Button } from "primitives/modal.slint";

// A native presentation, never a page-supplied network capability.
export global AgentCallUi {
    in property <bool> allowed;
    in property <bool> can-authorize;
    in property <string> usage-policy: I18n.t("agent.billingNotice");
    callback authorize-requested();
}

export component AgentCallAuthorization inherits VerticalLayout {
    in property <bool> compact;
    spacing: 4px;
    Text {
        text: AgentCallUi.usage-policy;
        color: Theme.fg-muted;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }
    Button {
        label: root.compact ? (AgentCallUi.allowed ? I18n.t("agent.revoke") : I18n.t("agent.allowCalls")) : (AgentCallUi.allowed ? I18n.t("agent.modelAuthorized") : I18n.t("agent.authorizeModel"));
        max-width: root.compact ? 120px : 100000px;
        enabled: AgentCallUi.can-authorize || AgentCallUi.allowed;
        primary: AgentCallUi.allowed;
        clicked => { AgentCallUi.authorize-requested(); }
    }
}
